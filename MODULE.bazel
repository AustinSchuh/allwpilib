bazel_dep(name = "aos")

# @aos's tools/lint and tools/go reference @go_sdk. rules_go only honors the
# `name` attribute of go_sdk.download in the root module, so @aos declares its
# own download as a dev_dependency (used when @aos is built standalone) and
# expects whoever consumes it to declare the equivalently named repo.
#
# Unlike @aos, which only builds on Linux and Apple Silicon, this has to list
# every host we build on: go_download_sdk fails with "unsupported platform" if
# the host tuple is missing from `sdks`. Hashes come from
# https://go.dev/dl/?mode=json&include=all.
bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    sdks = {
        "darwin_amd64": ("go1.24.13.darwin-amd64.tar.gz", "6cc6549b06725220b342b740497ffd24e0ebdcef75781a77931ca199f46ad781"),
        "darwin_arm64": ("go1.24.13.darwin-arm64.tar.gz", "f282d882c3353485e2fc6c634606d85caf36e855167d59b996dbeae19fa7629a"),
        "linux_amd64": ("go1.24.13.linux-amd64.tar.gz", "1fc94b57134d51669c72173ad5d49fd62afb0f1db9bf3f798fd98ee423f8d730"),
        "linux_arm64": ("go1.24.13.linux-arm64.tar.gz", "74d97be1cc3a474129590c67ebf748a96e72d9f3a2b6fef3ed3275de591d49b3"),
        "windows_amd64": ("go1.24.13.windows-amd64.zip", "40b16bc8f00540a2cb02dff4de72b73e966fdd8d65f95e33d8e4080b48a2459a"),
        "windows_arm64": ("go1.24.13.windows-arm64.zip", "e2c4e1b0c083965adecb893b97145f89bb8e39b3d745c6499fa1f8aa44bc065f"),
    },
    version = "1.24.13",
)

