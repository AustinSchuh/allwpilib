# @aos declares `bazel_dep(name = "hedron_compile_commands")` with no version and
# supplies the version itself via archive_override. Overrides are only honored in
# the root module, so we have to repeat it here. Keep in sync with ../aos/MODULE.bazel.
archive_override(
    module_name = "hedron_compile_commands",
    integrity = "sha256-Q0UaMr8nHnukY1oH95ltU1UB8GbA/o/qsE+wyR3VmG4=",
    strip_prefix = "bazel-compile-commands-extractor-daae6f40adfa5fdb7c89684cbe4d88b691c63b2d",
    urls = ["https://github.com/hedronvision/bazel-compile-commands-extractor/archive/daae6f40adfa5fdb7c89684cbe4d88b691c63b2d.tar.gz"],
)

AOS_SHA1 = "323bb90b32d77432762711bd9534a8d216bebf74"

archive_override(
    module_name = "aos",
    integrity = "sha256-mMt8RS551g8pRTUOnngKsv782kI7RyiYJbqAimvle3I=",
    strip_prefix = "aos-" + AOS_SHA1,
    urls = ["https://github.com/AustinSchuh/aos/archive/" + AOS_SHA1 + ".tar.gz"],
)

