# The sanitizers build with the hermetic clang. gcc's -Wmaybe-uninitialized
# reports false positives in libstdc++ under them, which -Werror makes fatal.
#
# Each enables the toolchain's sanitizer feature, which Bazel resets in the
# exec configuration, so build tools stay uninstrumented. Targets that can't
# run under a sanitizer select on //shared/bazel/toolchains/llvm:<sanitizer>
# in target_compatible_with (see shared/bazel/rules/sanitizers.bzl).
#
# Each also builds only tests. The publishing targets transition to other
# platforms, such as SystemCore's gcc, where the sanitizer features carry over
# and don't build.

# ASAN (address sanitizer) config
build:asan --config=clang
build:asan --platform_suffix=clang-asan
build:asan --run_under=//shared/bazel/toolchains/llvm:sanitizer_test_wrapper
build:asan --copt=-gline-tables-only
build:asan --features=asan
build:asan --copt -fno-omit-frame-pointer
build:asan --build_tests_only

# TSAN (thread sanitizer)
build:tsan --config=clang
build:tsan --platform_suffix=clang-tsan
build:tsan --run_under=//shared/bazel/toolchains/llvm:sanitizer_test_wrapper
build:tsan --copt=-gline-tables-only
build:tsan --strip=never
build:tsan --features=tsan
build:tsan --copt -DTHREAD_SANITIZER
build:tsan --copt -DDYNAMIC_ANNOTATIONS_ENABLED=1
build:tsan --copt -DDYNAMIC_ANNOTATIONS_EXTERNAL_IMPL=1
build:tsan --copt -O1
build:tsan --copt -fno-omit-frame-pointer
build:tsan --build_tests_only

# USAN (Undefined Behavior Sanitizer)
build:ubsan --config=clang
build:ubsan --platform_suffix=clang-ubsan
build:ubsan --run_under=//shared/bazel/toolchains/llvm:sanitizer_test_wrapper
build:ubsan --copt=-gline-tables-only
build:ubsan --features=ubsan
build:ubsan --copt -fno-sanitize-recover=all
build:ubsan --copt -fno-omit-frame-pointer
build:ubsan --linkopt -fno-sanitize-recover=all
build:ubsan --build_tests_only

# MSAN (memory sanitizer). The toolchain's msan feature swaps libstdc++ for
# an instrumented libc++, so anything linking a prebuilt libstdc++ library
# (OpenCV) can't build under it.
build:msan --config=clang
build:msan --platform_suffix=clang-msan
build:msan --run_under=//shared/bazel/toolchains/llvm:sanitizer_test_wrapper
build:msan --copt=-gline-tables-only
build:msan --features=msan
# The opt flags define _FORTIFY_SOURCE, which routes memcpy and friends
# through glibc's uninstrumented *_chk functions. MSan doesn't see those
# stores and reports the destination as uninitialized.
build:msan --copt=-U_FORTIFY_SOURCE
build:msan --build_tests_only
