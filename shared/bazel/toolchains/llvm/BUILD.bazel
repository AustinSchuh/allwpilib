load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

expand_template(
    name = "sanitizer_test_wrapper_sh",
    out = "sanitizer_test_wrapper.sh",
    data = [
        "//:tsan_suppressions.txt",
        "@llvm_toolchain_llvm//:bin/llvm-symbolizer",
    ],
    is_executable = True,
    substitutions = {
        "@SYMBOLIZER@": "$(rlocationpath @llvm_toolchain_llvm//:bin/llvm-symbolizer)",
        "@TSAN_SUPPRESSIONS@": "$(rlocationpath //:tsan_suppressions.txt)",
    },
    template = "sanitizer_test_wrapper.sh.in",
)

# Passed to the sanitizer configs as --run_under.
sh_binary(
    name = "sanitizer_test_wrapper",
    srcs = [":sanitizer_test_wrapper_sh"],
    data = [
        "//:tsan_suppressions.txt",
        "@llvm_toolchain_llvm//:bin/llvm-symbolizer",
    ],
)

# Match the sanitizer configs, which enable the toolchain's sanitizer features.
[
    config_setting(
        name = sanitizer,
        values = {"features": sanitizer},
        visibility = ["//visibility:public"],
    )
    for sanitizer in [
        "asan",
        "msan",
        "tsan",
        "ubsan",
    ]
]

# macOS starts an interpreter test through /usr/bin/env, which SIP protects,
# so the DYLD_INSERT_LIBRARIES the shared runtime would need never reaches the
# interpreter.
[
    selects.config_setting_group(
        name = sanitizer + "_macos",
        match_all = [
            ":" + sanitizer,
            "@platforms//os:macos",
        ],
        visibility = ["//visibility:public"],
    )
    for sanitizer in [
        "asan",
        "ubsan",
    ]
]

# The shared sanitizer runtimes an uninstrumented interpreter preloads for the
# instrumented code it loads (see shared/bazel/rules/sanitizers.bzl).
[
    alias(
        name = sanitizer + "_runtime",
        actual = select({
            "@platforms//os:macos": "@llvm_toolchain_llvm//:lib/clang/22/lib/darwin/libclang_rt.{}_osx_dynamic.dylib".format(sanitizer),
            "//conditions:default": "@llvm_toolchain_llvm//:lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.{}.so".format(linux_name),
        }),
        visibility = ["//visibility:public"],
    )
    for sanitizer, linux_name in [
        ("asan", "asan"),
        ("ubsan", "ubsan_standalone"),
    ]
]
