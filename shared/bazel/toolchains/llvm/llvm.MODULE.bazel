# Hermetic clang, used only with --config=clang. Nothing registers these
# toolchains; build:clang names them with --extra_toolchains, so the LLVM
# download only happens under that config.
bazel_dep(name = "toolchains_llvm", version = "1.11.0", dev_dependency = True)

# For the sanitizer test wrapper.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# Testing pins: the darwin toolchain built on apple_support, and the C++20
# module support it needs in apple_support and rules_cc, before any of them is
# released.
local_path_override(
    module_name = "toolchains_llvm",
    path = "../toolchains_llvm",
)

local_path_override(
    module_name = "apple_support",
    path = "../apple_support",
)

local_path_override(
    module_name = "rules_cc",
    path = "../rules_cc",
)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)

# The flags below restate what linux_flags.rc and osx_flags.rc feed the default
# toolchains through BAZEL_*OPTS, which only reaches rules_cc's autoconf.
_COMPILE_FLAGS = [
    "-Wextra",
    "-Werror",
    "-pedantic",
    "-Wno-unused-parameter",
    "-pthread",
    # abseil's headers use clang's nullability and enable_if extensions.
    "-Wno-nullability-extension",
    "-Wno-gcc-compat",
]

_LINUX_COMPILE_FLAGS = _COMPILE_FLAGS + [
    "-gz=zlib",
    "-Wformat=2",
    "-Wno-psabi",
    # linux_flags.rc and the linux platforms pass gcc-only warning flags,
    # which gcc ignores and clang warns about.
    "-Wno-unknown-warning-option",
]

_LINUX_LINK_FLAGS = [
    "-rdynamic",
    "-pthread",
    "-ldl",
    "-latomic",
    "-Wl,-rpath,$ORIGIN",
    "-gz=zlib",
]

_LINUX_TARGETS = [
    "linux-aarch64",
    "linux-x86_64",
]

# On Linux, clang compiles against the host's glibc and links the host's
# libstdc++ 14 (Debian trixie, as on RBE), the same libraries the gcc toolchain
# uses. On macOS, it uses the SDK's libc++, as Apple clang does.
llvm.toolchain(
    name = "llvm_toolchain",
    # Unlike the other flag attributes, conly_flags has no "" fallback; each
    # target needs its own key.
    conly_flags = {
        target: [
            # The HAL's C headers give enums a fixed underlying type.
            "-Wno-c23-extensions",
        ]
        for target in _LINUX_TARGETS + ["darwin-aarch64"]
    },
    cxx_standard = {"": "c++23"},
    extra_compile_flags = {
        target: _LINUX_COMPILE_FLAGS
        for target in _LINUX_TARGETS
    } | {
        "darwin-aarch64": _COMPILE_FLAGS + [
            "-Wno-shorten-64-to-32",
            # Catch2 suppresses this for __COUNTER__ on clang 22, but not
            # when __APPLE__ is defined, taking that to mean Apple clang.
            "-Wno-c2y-extensions",
        ],
    },
    extra_cxx_flags = {
        target: [
            "-Wno-deprecated-enum-enum-conversion",
            "-Wno-array-bounds",
        ]
        for target in _LINUX_TARGETS
    } | {
        "darwin-aarch64": [
            "-Wno-deprecated-enum-enum-conversion",
            "-Wno-deprecated-anon-enum-enum-conversion",
            "-Wno-missing-field-initializers",
        ],
    },
    extra_link_flags = {
        target: _LINUX_LINK_FLAGS
        for target in _LINUX_TARGETS
    } | {
        "darwin-aarch64": [
            "-Wl,-rpath,@loader_path",
        ],
    },
    # MemorySanitizer-instrumented libc++, which --features=msan swaps in.
    libcxx_sha256 = "fd1ac49eeda4edc6deeda2037998e558718a63a5054fff4fdace7751b270217a",
    libcxx_url = "https://github.com/RealtimeRoboticsGroup/toolchains/releases/download/22.1.8/libcxx-msan-22.1.8-x86_64-linux-gnu-ubuntu-22.04.tar.zst",
    llvm_version = "22.1.8",
    stdlib = {
        # The SDK's libc++.
        "darwin-aarch64": "builtin-libc++",
        # SystemCore's sysroot keeps libstdc++ in a Buildroot layout that clang
        # finds on its own.
        "linux-aarch64": "dynamic-stdc++",
        # Naming the version makes the toolchain find libstdc++ by path rather
        # than pass -stdlib=libstdc++, so msan can drop it for its libc++.
        "linux-x86_64": "dynamic-stdc++-14",
    },
)

# The host's root, so the libstdc++ paths dynamic-stdc++-14 generates are
# absolute.
llvm.sysroot(
    name = "llvm_toolchain",
    path = "/",
    targets = ["linux-x86_64"],
)

# SystemCore: the sysroot from the same opensdk toolchain the gcc build uses,
# and only for the SystemCore platform, not other arm64 Linux targets.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "systemcore_sysroot",
    build_file_content = """filegroup(
    name = "sysroot",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    dev_dependency = True,
    sha256 = "992d4f2037762588c062f5b22f282b92b9143a2e8cb39a2027e67249c8ed5bea",
    strip_prefix = "systemcore/aarch64-linux-gnu/sysroot",
    url = "https://github.com/wpilibsuite/opensdk/releases/download/v2027-1/arm64-systemcore-2027-x86_64-linux-gnu-Toolchain-14.3.0.tgz",
)

llvm.sysroot(
    name = "llvm_toolchain",
    label = "@systemcore_sysroot//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.extra_target_compatible_with(
    name = "llvm_toolchain",
    constraints = ["@wpilib_toolchains//constraints/is_systemcore:true"],
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")
