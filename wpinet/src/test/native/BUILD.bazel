load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//shared/bazel/rules:sanitizers.bzl", "incompatible_with_sanitizer")

cc_library(
    name = "main",
    srcs = ["cpp/main.cpp"],
    deps = [
        "//thirdparty/catch2",
    ],
)

cc_test(
    name = "tests",
    size = "small",
    srcs = glob(
        [
            "cpp/**/*.cpp",
            "cpp/**/*.hpp",
        ],
        exclude = [
            "cpp/main.cpp",
            "cpp/MulticastTest.cpp",
        ],
    ),
    deps = [
        ":main",
        "//thirdparty/catch2",
        "//wpinet",
        "//wpiutil:wpiutil-testlib",
    ],
)

cc_test(
    name = "MulticastTest",
    size = "small",
    srcs = ["cpp/MulticastTest.cpp"],
    tags = [
        "no-remote-exec",  # requires avahi-daemon
    ],
    target_compatible_with = incompatible_with_sanitizer("asan"),
    deps = [
        ":main",
        "//thirdparty/catch2",
        "//wpinet",
    ],
)
