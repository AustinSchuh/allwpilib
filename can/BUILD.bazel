load("@aos//aos:config.bzl", "aos_config")
load("@aos//aos/flatbuffers:generate.bzl", "static_flatbuffer")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# SocketCAN (linux/can.h) is Linux-only.
LINUX_ONLY = ["@platforms//os:linux"]

static_flatbuffer(
    name = "can_logging_fbs",
    srcs = ["src/main/native/fbs/CanLogging.fbs"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "can",
    srcs = ["src/main/native/cpp/CanLogger.cpp"],
    hdrs = ["src/main/native/include/wpi/can/CanLogger.hpp"],
    strip_include_prefix = "src/main/native/include",
    target_compatible_with = LINUX_ONLY,
    visibility = ["//visibility:public"],
    deps = [
        ":can_logging_fbs",
        "//wpiutil",
        "@aos//aos:realtime",
        "@aos//aos/events:shm_event_loop",
        "@aos//aos/scoped:scoped_fd",
    ],
)

cc_binary(
    name = "can_logger",
    srcs = ["src/main/native/cpp/main.cpp"],
    target_compatible_with = LINUX_ONLY,
    visibility = ["//visibility:public"],
    deps = [
        ":can",
        "//wpiutil",
        "@aos//aos:configuration",
        "@aos//aos:init",
        "@aos//aos:realtime",
        "@aos//aos/events:shm_event_loop",
    ],
)

aos_config(
    name = "aos_config",
    src = "aos_config_source.json",
    flatbuffers = [
        ":can_logging_fbs",
        "@aos//aos/events:event_loop_fbs",
        "@aos//aos/logging:dynamic_log_command_fbs",
        "@aos//aos/logging:log_message_fbs",
        "@aos//aos/testing/ping_pong:ping_fbs",
        "@aos//aos/testing/ping_pong:pong_fbs",
    ],
)

cc_test(
    name = "can-cpp-test",
    size = "small",
    srcs = glob(["src/test/native/**/*.cpp"]),
    data = [":aos_config"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":can",
        "//thirdparty/catch2",
        "//wpiutil:wpiutil-testlib",
        "@aos//aos:init",
        "@aos//aos/events:simulated_event_loop",
    ],
)

# @aos's own ping/pong test, run from here to prove the dependency is wired up
# end to end.
test_suite(
    name = "pingpong_test",
    tests = ["@aos//aos/testing/ping_pong:pingpong_test"],
)

pkg_tar(
    name = "example",
    srcs = [
        ":aos_config",
        ":can_logger",
        "@aos//aos:aos_dump",
        "@aos//aos:aos_send",
        "@aos//aos/events:aos_timing_report_streamer",
        # Record the /can channel to disk, and read the logs back.
        "@aos//aos/events/logging:log_cat",
        "@aos//aos/events/logging:logger_main",
        "@aos//aos/starter:irq_affinity",
        "@aos//aos/util:foxglove_websocket",
        "@aos//documentation/examples/ping_pong:ping",
        "@aos//documentation/examples/ping_pong:pong",
        # IPC latency and stress tools, for characterizing a new platform.
        "@aos//aos/ipc_lib:eventfd_latency",
        "@aos//aos/ipc_lib:futex_latency",
        "@aos//aos/ipc_lib:ipc_comparison",
        "@aos//aos/ipc_lib:named_pipe_latency",
        "@aos//aos/ipc_lib:signal_stress",
    ],
)
